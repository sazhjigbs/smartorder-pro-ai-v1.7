# 🔥 SAFELOGIC SmartOrder PRO - Configuration
# by MAIGA ABOUBACAR
# ================================================

# ==================== TRADING MODE ====================

# Paper Trading (true = simulation, false = REAL trading)
# ⚠️ SET TO false POUR TRADER RÉEL !
PAPER_TRADING=false

# Active Exchange (bybit | binance | okx | kucoin)
ACTIVE_EXCHANGE=bybit

# Testnet mode (true = testnet, false = mainnet)
USE_TESTNET=false

# ==================== BYBIT ====================

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_RECV_WINDOW=5000

# ==================== BINANCE (Optional) ====================

BINANCE_API_KEY=
BINANCE_API_SECRET=

# ==================== OKX (Optional) ====================

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ==================== KUCOIN (Optional) ====================

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# ==================== TELEGRAM BOT ====================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==================== SECURITY ====================

# Encryption (true = encrypt API keys in database)
USE_ENCRYPTION=true

# Session secrets
SESSION_SECRET=your_random_session_secret_here
JWT_SECRET=your_random_jwt_secret_here

# ==================== DATABASE ====================

DATABASE_PATH=data/smartorder.db

# ==================== LOGGING ====================

LOG_LEVEL=INFO

# ==================== DASHBOARD ====================

DASHBOARD_PORT=8555
DASHBOARD_HOST=0.0.0.0

# ==================== NOTES ====================
# 
# 1. SÉCURITÉ:
#    - JAMAIS commit ce fichier avec de vraies clés API
#    - Utiliser USE_ENCRYPTION=true en production
#    - Activer IP whitelist sur exchanges
#    - Permissions API: Read + Trade ONLY (NO withdrawal!)
#
# 2. PAPER TRADING:
#    - Toujours tester avec PAPER_TRADING=true d'abord
#    - Vérifier testnet avant mainnet
#
# 3. MULTI-EXCHANGE:
#    - Laisser vide les exchanges non utilisés
#    - Le bot active automatiquement les exchanges configurés
#
# ================================================
