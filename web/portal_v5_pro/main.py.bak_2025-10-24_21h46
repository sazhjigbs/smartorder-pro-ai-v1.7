# ==============================================================
# 🧠 API SYSTEM STATUS
# ==============================================================
@app.get("/api/system_status")
def system_status():
    cpu = psutil.cpu_percent(interval=0.5)
    ram = psutil.virtual_memory().percent
    disk = psutil.disk_usage("/").percent
    services = {
        "smartorder-proxy": subprocess.getoutput("systemctl is-active smartorder-proxy.service"),
        "smartorder-websync-bridge": subprocess.getoutput("systemctl is-active smartorder-websync-bridge.service"),
        "smartorder-watchdog": subprocess.getoutput("systemctl is-active smartorder-watchdog.service"),
    }
    return {"cpu":cpu,"ram":ram,"disk":disk,"services":services,"timestamp":time.strftime("%Y-%m-%d %H:%M:%S")}

# ==============================================================
# 🔌 API PROXY STATUS
# ==============================================================
@app.get("/api/proxy_status")
def proxy_status():
    port_check = subprocess.getoutput("ss -tulnp | grep 8787 | wc -l")
    return {"proxy":"🟢 actif","port":8787} if int(port_check)>0 else {"proxy":"🔴 inactif","port":None}

# ==============================================================
# 📡 API SIGNALS LIVE — lecture log bridge
# ==============================================================
@app.get("/api/signals_live")
def signals_live():
    path = "/opt/smartorder-pro/logs/websync_bridge.log"
    if not os.path.exists(path):
        return [{"symbol":"—","type":"—","confidence":"—","pnl":"—","time":"—"}]
    lines = subprocess.getoutput(f"tail -n 10 {path}").splitlines()
    result = []
    for l in lines:
        if "Buy" in l or "Sell" in l:
            parts = l.split()
            symbol = parts[0] if len(parts)>0 else "?"
            side = "Buy" if "Buy" in l else "Sell"
            price = parts[-1] if parts[-1].replace('.','',1).isdigit() else "?"
            result.append({
                "symbol":symbol,
                "type":side,
                "confidence":"95",
                "pnl":"—",
                "time":time.strftime("%H:%M:%S")
            })
    return result if result else [{"symbol":"—","type":"—","confidence":"—","pnl":"—","time":"—"}]
