[Unit]
Description=SmartOrder PRO - Auto Trading Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smartorder-pro
Environment="PATH=/opt/smartorder-pro/venv/bin"
Environment="PYTHONPATH=/opt/smartorder-pro"
EnvironmentFile=/opt/smartorder-pro/.env
ExecStart=/opt/smartorder-pro/venv/bin/python3 core/auto_trading_engine.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/smartorder-pro/logs/auto_trading.log
StandardError=append:/opt/smartorder-pro/logs/auto_trading.log

# Limits
CPUQuota=20%
MemoryLimit=150M

[Install]
WantedBy=multi-user.target
